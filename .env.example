PORT=4000
# A dedicated, non-superuser role is recommended (see README "Database user").
# Tests and e2e reuse this server and credentials with their own databases.
DATABASE_URL=postgres://sg_app:change-me@localhost:5432/star_generation
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins of the two frontends
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development
