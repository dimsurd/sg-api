PORT=4000
# Bind address. Use 127.0.0.1 when behind a reverse proxy (nginx); omit for all interfaces.
# HOST=127.0.0.1
# A dedicated, non-superuser role is recommended (see README "Database user").
# Tests and e2e reuse this server and credentials with their own databases.
DATABASE_URL=postgres://sg_app:change-me@localhost:5432/star_generation
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins of the two frontends
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=development

# Optional AI class advisor for students: any OpenAI-compatible /chat/completions API.
# Leave LLM_API_KEY empty to hide the feature.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Provider-specific request fields (JSON), e.g. to turn off Qwen3 thinking on vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
